# ==============================================================================
# TridoshaLab (tridoshalab.com) — Production Environment Configuration Template
# ==============================================================================
# NOTE: Copy this file to '.env' and populate with production values.
# NEVER commit real credentials, passwords, or production secrets into version control.

# --- SERVER / NETWORK CONFIGURATION ---
# Port for the Node.js / Express backend server.
# For single-domain deployments, Express serves both API routes (/api/*) and the frontend SPA (dist/).
# In production on PaaS (Render, Heroku, Railway, Fly.io), the PORT variable is typically injected automatically.
PORT=5000

# Environment mode: 'development', 'production', or 'test'
NODE_ENV=production

# --- CORS & ORIGIN CONTROL ---
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# When frontend and backend share the same domain (https://tridoshalab.com), CORS is handled automatically.
ALLOWED_ORIGINS=https://tridoshalab.com,https://www.tridoshalab.com,http://localhost:3000,http://localhost:5000,http://localhost:5173

# --- AUTHENTICATION & SECURITY ---
# Cryptographic secret key used to sign and verify JSON Web Tokens (JWT) for clinicians.
# CRITICAL: In production, generate a secure random 64-character hex/base64 string.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production
JWT_EXPIRES_IN=24h

# --- DATABASE PERSISTENCE CONFIGURATION ---
# Optional PostgreSQL connection URI.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty, TridoshaLab automatically runs with zero setup using its built-in ACID JSON storage engine (server/data/db.json).
DATABASE_URL=

# PostgreSQL connection pool tuning (applicable only when DATABASE_URL is set)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

# --- RATE LIMITING & ABUSE PROTECTION ---
# General API rate limiting parameters to guard against Denial of Service (DoS) and brute force
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- CLINICAL ALGORITHM CALIBRATION ---
# Dominant Dosha threshold percentage (SDM College of Ayurveda institutional standard)
ADAPTIVE_DOSHA_THRESHOLD=80
CACHE_ENABLED=true

# --- FRONTEND CLIENT BUILD CONFIGURATION (VITE) ---
# Base URL for API requests made by the React frontend.
# Leave blank or set to '/api' for unified single-domain hosting at https://tridoshalab.com.
# If frontend is hosted on Vercel/Netlify and backend on Render/Fly.io, set to the backend URL (e.g. https://api.tridoshalab.com).
VITE_API_URL=/api
